{
  "name": "axe-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check",
    "lint": "svelte-check && eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:component": "vitest run",
    "test:rules": "node --test tests/firestore.rules.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "@grpc/grpc-js": "^1.14.6",
    "brace-expansion": "^5.0.9",
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "firebase": "^13.3.0",
    "svelte5-router": "^3.1.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "core-js@3.49.0": true,
    "es5-ext@0.10.64": true,
    "protobufjs@7.6.6": true
  }
}
